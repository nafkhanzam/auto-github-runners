# GitHub Self-Hosted Runner Environment Variables
# Copy this file to .env and fill in the values

# --- Required ---

# GitHub repository (format: <owner>/<repo>) or organization (format: <owner>)
REPO=<owner>/<repo>

# GitHub PAT (classic: `repo` scope, or `admin:org` for orgs; fine-grained:
# "Administration: read/write" for repos, "Self-hosted runners: read/write" for orgs).
# Used to mint fresh registration/removal tokens on every start.
ACCESS_TOKEN=your_pat_here

# Display name for this runner
NAME=my-runner

# --- Optional ---

# Comma-separated labels to tag this runner (e.g. self-hosted,linux,x64,gpu)
# LABELS=self-hosted,linux,x64

# Runner group name (org/enterprise only)
# RUNNER_GROUP=default

# Workspace directory, relative to each runner's dir (never absolute: runners would collide)
# WORK_DIR=_work

# Set to "true" to register as ephemeral — runner deregisters after one job
# EPHEMERAL=false

# Set to "true" to deregister the runner when its service stops (runners.sh down always deregisters)
# REMOVE_RUNNER_ON_EXIT=false

# Directory holding runner-1..N (relative to this repo or absolute)
# RUNNER_BASE_DIR=runners
